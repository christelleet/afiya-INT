<!DOCTYPE html>
<html lang="de-CH">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Afiya · Taskboard</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌿</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<style>
/* =========================================================
   KONFIGURATION: siehe <script> ganz unten (CONFIG)
   ========================================================= */
:root{
  --bg:#EDF1EC; --surface:#FFFFFF; --surface-2:#F6F8F5;
  --ink:#1B2A25; --muted:#64746D; --line:#D5DDD6;
  --accent:#1F6F55; --accent-ink:#FFFFFF;
  --hi:#B8403A; --mid:#C98A12; --lo:#4F8A74;
  --col-backlog:#8C9A93; --col-todo:#3E6FA8; --col-doing:#C98A12; --col-review:#7A5BA6; --col-done:#1F6F55;
  --radius-card:10px; --radius-ctrl:8px;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#121A17; --surface:#1B2521; --surface-2:#16201C;
    --ink:#E6EEE9; --muted:#97A8A0; --line:#2C3A34;
    --accent:#4FB38E; --accent-ink:#0E1714;
  }
}
*,*::before,*::after{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Figtree,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:15px;line-height:1.45;display:flex;flex-direction:column}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* Kopfzeile */
header{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;padding:18px 24px 14px}
.brand{display:flex;align-items:baseline;gap:10px;margin-right:auto}
.brand h1{font-family:"Bricolage Grotesque",Figtree,sans-serif;font-weight:700;font-size:28px;letter-spacing:-.02em;margin:0}
.brand span{color:var(--muted);font-size:14px}
.tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.tools input,.tools select{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-ctrl);padding:8px 10px;min-width:0}
.tools input{width:200px}
.btn{border:0;border-radius:var(--radius-ctrl);padding:9px 14px;cursor:pointer;font-weight:600;background:var(--surface);border:1px solid var(--line)}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.danger{background:transparent;color:var(--hi);border-color:transparent}
.me{font-size:14px;color:var(--muted);cursor:pointer;background:none;border:0;padding:4px}
.me b{color:var(--ink)}
.status-dot{width:8px;height:8px;border-radius:50%;background:var(--muted);display:inline-block;margin-right:6px}
.status-dot.live{background:var(--lo)}
.banner{margin:0 24px 10px;padding:10px 14px;border-radius:var(--radius-ctrl);background:#FFF4D6;color:#5A4500;font-size:14px}
@media (prefers-color-scheme: dark){.banner{background:#3A3115;color:#F2DE9C}}

/* Board */
main{flex:1;overflow-x:auto;padding:4px 24px 24px}
.board{display:grid;grid-template-columns:repeat(5,minmax(250px,1fr));gap:14px;min-height:100%;align-items:start}
.col{background:var(--surface-2);border-radius:12px;display:flex;flex-direction:column;max-height:calc(100vh - 150px);border-top:4px solid var(--c)}
.col-head{display:flex;align-items:center;justify-content:space-between;padding:12px 14px 8px}
.col-head h2{font-family:"Bricolage Grotesque",Figtree,sans-serif;font-size:17px;font-weight:500;margin:0}
.count{font-family:"Bricolage Grotesque",sans-serif;font-size:22px;font-weight:700;color:var(--c)}
.list{flex:1;overflow-y:auto;padding:4px 10px 10px;display:flex;flex-direction:column;gap:8px;min-height:80px}
.list.over{background:color-mix(in srgb,var(--c) 10%,transparent);border-radius:8px}
.add-inline{margin:0 10px 10px;background:none;border:1px dashed var(--line);border-radius:var(--radius-ctrl);padding:8px;color:var(--muted);cursor:pointer;text-align:left}
.add-inline:hover{color:var(--ink);border-color:var(--muted)}

.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-card);padding:10px 12px;cursor:grab;position:relative}
.card:hover{border-color:var(--muted)}
.card.dragging{opacity:.4}
.card h3{margin:0 0 4px;font-size:15px;font-weight:600;line-height:1.3;word-break:break-word}
.card p{margin:0 0 8px;color:var(--muted);font-size:13.5px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.meta{display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:12.5px;color:var(--muted)}
.pill{padding:2px 8px;border-radius:999px;background:var(--bg)}
.prio{border-left:3px solid transparent;padding-left:6px}
.prio.hoch{border-color:var(--hi);color:var(--hi)}
.prio.mittel{border-color:var(--mid)}
.prio.tief{border-color:var(--lo)}
.due.overdue{color:var(--hi);font-weight:600}
.avatar{width:22px;height:22px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:inline-grid;place-items:center;font-size:11px;font-weight:600;margin-left:auto}
.empty{color:var(--muted);font-size:13px;padding:10px 4px}

/* Dialog */
dialog{border:0;border-radius:14px;padding:0;width:min(520px,calc(100vw - 24px));background:var(--surface);color:var(--ink)}
dialog::backdrop{background:rgba(10,20,16,.45)}
.dlg{padding:20px 22px;display:grid;gap:12px}
.dlg h2{margin:0 0 4px;font-family:"Bricolage Grotesque",sans-serif;font-weight:700;font-size:22px}
label{display:grid;gap:4px;font-size:13px;color:var(--muted);font-weight:500}
.dlg input,.dlg select,.dlg textarea{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-ctrl);padding:9px 10px;color:var(--ink);font-size:15px}
.dlg textarea{min-height:100px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.actions{display:flex;gap:8px;align-items:center;margin-top:6px}
.actions .spacer{flex:1}
.hint{font-size:12.5px;color:var(--muted);margin:0}

@media (max-width:700px){
  header{padding:14px 14px 10px}
  main{padding:4px 14px 18px}
  .tools input{width:100%}
  .tools{width:100%}
  .board{grid-template-columns:repeat(5,82vw)}
  .row{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<header>
  <div class="brand">
    <h1>Afiya</h1>
    <span><i class="status-dot" id="syncDot"></i><span id="syncText">verbinde…</span></span>
  </div>
  <div class="tools">
    <input id="search" type="search" placeholder="Tasks durchsuchen" aria-label="Tasks durchsuchen">
    <select id="filter" aria-label="Nach Person filtern"></select>
    <button class="btn primary" id="newBtn">Neuer Task</button>
    <button class="me" id="meBtn" title="Namen ändern"></button>
  </div>
</header>
<div class="banner" id="localBanner" hidden>Testmodus: Supabase ist noch nicht eingerichtet. Änderungen werden nur in diesem Browser gespeichert und sind für das Team nicht sichtbar.</div>

<main><div class="board" id="board"></div></main>

<!-- Task-Dialog -->
<dialog id="taskDlg">
  <form method="dialog" class="dlg" id="taskForm">
    <h2 id="dlgTitle">Neuer Task</h2>
    <label>Titel<input name="title" required maxlength="140" autocomplete="off"></label>
    <label>Beschreibung<textarea name="description" maxlength="4000"></textarea></label>
    <div class="row">
      <label>Status<select name="status"></select></label>
      <label>Verantwortlich<select name="assignee"></select></label>
    </div>
    <div class="row">
      <label>Priorität
        <select name="priority"><option value="hoch">Hoch</option><option value="mittel" selected>Mittel</option><option value="tief">Tief</option></select>
      </label>
      <label>Fällig am<input type="date" name="due"></label>
    </div>
    <p class="hint" id="createdInfo"></p>
    <div class="actions">
      <button type="button" class="btn danger" id="deleteBtn" hidden>Löschen</button>
      <span class="spacer"></span>
      <button type="button" class="btn" id="cancelBtn">Abbrechen</button>
      <button type="submit" class="btn primary" id="saveBtn">Speichern</button>
    </div>
  </form>
</dialog>

<!-- Namens-/Zugangsdialog -->
<dialog id="whoDlg">
  <form method="dialog" class="dlg" id="whoForm">
    <h2>Wer bist du?</h2>
    <p class="hint">Dein Name wird bei neuen Tasks gespeichert und für den Filter «Meine Tasks» verwendet.</p>
    <label>Name<input name="name" list="memberList" required autocomplete="off"></label>
    <datalist id="memberList"></datalist>
    <label id="codeLabel" hidden>Team-Code<input name="code" type="password" autocomplete="off"></label>
    <p class="hint" id="whoError" style="color:var(--hi)"></p>
    <div class="actions"><span class="spacer"></span><button type="submit" class="btn primary">Weiter</button></div>
  </form>
</dialog>

<script>
/* =========================================================
   KONFIGURATION – hier anpassen
   ========================================================= */
const CONFIG = {
  // Aus Supabase: Project Settings → API
  SUPABASE_URL: "",        // z.B. "https://abcdxyz.supabase.co"
  SUPABASE_ANON_KEY: "",   // der «anon public» Key

  // Teammitglieder (erscheinen in Auswahl & Filter)
  MEMBERS: ["Christelle", "Person 2", "Person 3"],

  // Optional: einfacher Team-Code als Sichtschutz (kein echter Zugriffsschutz)
  TEAM_CODE: "",
};

const COLUMNS = [
  { id: "backlog", name: "Ideen",         color: "var(--col-backlog)" },
  { id: "todo",    name: "Zu erledigen",  color: "var(--col-todo)" },
  { id: "doing",   name: "In Arbeit",     color: "var(--col-doing)" },
  { id: "review",  name: "Zur Prüfung",   color: "var(--col-review)" },
  { id: "done",    name: "Erledigt",      color: "var(--col-done)" },
];

/* ---------- Hilfsfunktionen ---------- */
const $ = s => document.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
const store = {
  get(k){ try { return localStorage.getItem(k); } catch { return null; } },
  set(k,v){ try { localStorage.setItem(k,v); } catch {} },
};
const initials = n => (n||"?").split(/\s+/).map(w=>w[0]).join("").slice(0,2).toUpperCase();
const today = () => new Date().toISOString().slice(0,10);
const fmtDate = d => d ? new Date(d+"T00:00:00").toLocaleDateString("de-CH",{day:"numeric",month:"short"}) : "";

/* ---------- Datenschicht: Supabase oder lokal ---------- */
const useRemote = !!(CONFIG.SUPABASE_URL && CONFIG.SUPABASE_ANON_KEY && window.supabase);
let sb = null;
if (useRemote) sb = window.supabase.createClient(CONFIG.SUPABASE_URL, CONFIG.SUPABASE_ANON_KEY);

const api = {
  async list(){
    if (!useRemote) { try { return JSON.parse(store.get("afiya-tasks") || "[]"); } catch { return []; } }
    const { data, error } = await sb.from("tasks").select("*").order("position", { ascending: true });
    if (error) throw error; return data;
  },
  async insert(t){
    if (!useRemote) { t.id = crypto.randomUUID(); t.created_at = new Date().toISOString(); tasks.push(t); saveLocal(); return; }
    const { error } = await sb.from("tasks").insert(t); if (error) throw error;
  },
  async update(id, patch){
    patch.updated_at = new Date().toISOString();
    if (!useRemote) { Object.assign(tasks.find(t=>t.id===id), patch); saveLocal(); return; }
    const { error } = await sb.from("tasks").update(patch).eq("id", id); if (error) throw error;
  },
  async remove(id){
    if (!useRemote) { tasks = tasks.filter(t=>t.id!==id); saveLocal(); return; }
    const { error } = await sb.from("tasks").delete().eq("id", id); if (error) throw error;
  },
  subscribe(onChange){
    if (!useRemote) return;
    sb.channel("tasks-live")
      .on("postgres_changes", { event: "*", schema: "public", table: "tasks" }, onChange)
      .subscribe(status => setSync(status === "SUBSCRIBED" ? "live" : "wait"));
  },
};
function saveLocal(){ store.set("afiya-tasks", JSON.stringify(tasks)); }

/* ---------- Zustand ---------- */
let tasks = [];
let me = store.get("afiya-me") || "";
let editingId = null;

function setSync(state, msg){
  const dot = $("#syncDot"), txt = $("#syncText");
  dot.classList.toggle("live", state === "live");
  txt.textContent = msg || ({ live:"live synchronisiert", wait:"verbinde…", local:"Testmodus", error:"Verbindung fehlgeschlagen" }[state]);
}

async function refresh(){
  try { tasks = await api.list(); render(); }
  catch (e) { console.error(e); setSync("error", "Laden fehlgeschlagen – Konfiguration prüfen"); }
}

/* ---------- Rendering ---------- */
function visibleTasks(){
  const q = $("#search").value.trim().toLowerCase();
  const f = $("#filter").value;
  return tasks.filter(t => {
    if (f === "__me" && t.assignee !== me) return false;
    if (f === "__none" && t.assignee) return false;
    if (f && !f.startsWith("__") && t.assignee !== f) return false;
    if (q && !(`${t.title} ${t.description||""} ${t.assignee||""}`.toLowerCase().includes(q))) return false;
    return true;
  });
}

function render(){
  const vis = visibleTasks();
  const board = $("#board");
  board.innerHTML = COLUMNS.map(c => {
    const items = vis.filter(t => t.status === c.id).sort((a,b)=>(a.position??0)-(b.position??0));
    return `
    <section class="col" style="--c:${c.color}" aria-label="${c.name}">
      <div class="col-head"><h2>${c.name}</h2><span class="count">${items.length}</span></div>
      <div class="list" data-status="${c.id}">
        ${items.length ? items.map(cardHTML).join("") : `<div class="empty">Keine Tasks</div>`}
      </div>
      <button class="add-inline" data-add="${c.id}">+ Task hinzufügen</button>
    </section>`;
  }).join("");
}

function cardHTML(t){
  const overdue = t.due && t.due < today() && t.status !== "done";
  return `
  <article class="card" draggable="true" tabindex="0" data-id="${t.id}">
    <h3>${esc(t.title)}</h3>
    ${t.description ? `<p>${esc(t.description)}</p>` : ""}
    <div class="meta">
      <span class="prio ${esc(t.priority||"mittel")}">${esc((t.priority||"mittel").replace(/^./,c=>c.toUpperCase()))}</span>
      ${t.due ? `<span class="due ${overdue?"overdue":""}">${overdue?"überfällig ":""}${fmtDate(t.due)}</span>` : ""}
      ${t.assignee ? `<span class="avatar" title="${esc(t.assignee)}">${esc(initials(t.assignee))}</span>` : ""}
    </div>
  </article>`;
}

function fillSelects(){
  const opts = CONFIG.MEMBERS.map(m=>`<option value="${esc(m)}">${esc(m)}</option>`).join("");
  $("#filter").innerHTML = `<option value="">Alle Personen</option><option value="__me">Meine Tasks</option><option value="__none">Nicht zugewiesen</option>${opts}`;
  $('[name=assignee]').innerHTML = `<option value="">Niemand</option>${opts}`;
  $('[name=status]').innerHTML = COLUMNS.map(c=>`<option value="${c.id}">${c.name}</option>`).join("");
  $("#memberList").innerHTML = opts;
}

/* ---------- Dialog ---------- */
function openTask(id, status){
  const f = $("#taskForm");
  f.reset();
  editingId = id || null;
  const t = id ? tasks.find(x=>x.id===id) : null;
  $("#dlgTitle").textContent = t ? "Task bearbeiten" : "Neuer Task";
  $("#deleteBtn").hidden = !t;
  f.elements.title.value = t?.title || "";
  f.elements.description.value = t?.description || "";
  f.elements.status.value = t?.status || status || "todo";
  f.elements.assignee.value = t?.assignee || "";
  f.elements.priority.value = t?.priority || "mittel";
  f.elements.due.value = t?.due || "";
  $("#createdInfo").textContent = t?.created_by ? `Erstellt von ${t.created_by}${t.created_at ? " am " + new Date(t.created_at).toLocaleDateString("de-CH") : ""}` : "";
  $("#taskDlg").showModal();
  f.elements.title.focus();
}

$("#taskForm").addEventListener("submit", async e => {
  e.preventDefault();
  const f = e.target;
  const data = {
    title: f.elements.title.value.trim(),
    description: f.elements.description.value.trim() || null,
    status: f.elements.status.value,
    assignee: f.elements.assignee.value || null,
    priority: f.elements.priority.value,
    due: f.elements.due.value || null,
  };
  if (!data.title) return;
  try {
    if (editingId) {
      const old = tasks.find(t=>t.id===editingId);
      if (old.status !== data.status) data.position = endPosition(data.status);
      await api.update(editingId, data);
    } else {
      await api.insert({ ...data, position: endPosition(data.status), created_by: me });
    }
    $("#taskDlg").close();
    refresh();
  } catch (err) { alert("Speichern fehlgeschlagen: " + err.message); }
});

$("#deleteBtn").addEventListener("click", async () => {
  if (!editingId || !confirm("Diesen Task endgültig löschen?")) return;
  try { await api.remove(editingId); $("#taskDlg").close(); refresh(); }
  catch (err) { alert("Löschen fehlgeschlagen: " + err.message); }
});
$("#cancelBtn").addEventListener("click", () => $("#taskDlg").close());

function endPosition(status){
  const ps = tasks.filter(t=>t.status===status).map(t=>t.position??0);
  return ps.length ? Math.max(...ps) + 1 : 1;
}

/* ---------- Klicks ---------- */
$("#board").addEventListener("click", e => {
  const add = e.target.closest("[data-add]");
  if (add) return openTask(null, add.dataset.add);
  const card = e.target.closest(".card");
  if (card) openTask(card.dataset.id);
});
$("#board").addEventListener("keydown", e => {
  const card = e.target.closest(".card");
  if (card && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); openTask(card.dataset.id); }
});
$("#newBtn").addEventListener("click", () => openTask(null, "todo"));
$("#search").addEventListener("input", render);
$("#filter").addEventListener("change", render);

/* ---------- Drag & Drop ---------- */
let dragId = null;
$("#board").addEventListener("dragstart", e => {
  const card = e.target.closest(".card"); if (!card) return;
  dragId = card.dataset.id; card.classList.add("dragging");
  e.dataTransfer.effectAllowed = "move";
});
$("#board").addEventListener("dragend", e => {
  e.target.closest(".card")?.classList.remove("dragging");
  document.querySelectorAll(".list.over").forEach(l=>l.classList.remove("over"));
});
$("#board").addEventListener("dragover", e => {
  const list = e.target.closest(".list"); if (!list || !dragId) return;
  e.preventDefault();
  document.querySelectorAll(".list.over").forEach(l=>{ if(l!==list) l.classList.remove("over"); });
  list.classList.add("over");
});
$("#board").addEventListener("drop", async e => {
  const list = e.target.closest(".list"); if (!list || !dragId) return;
  e.preventDefault();
  list.classList.remove("over");
  const status = list.dataset.status;
  const cards = [...list.querySelectorAll(".card")].filter(c => c.dataset.id !== dragId);
  const after = cards.find(c => e.clientY < c.getBoundingClientRect().top + c.offsetHeight/2);
  const idx = after ? cards.indexOf(after) : cards.length;
  const pos = id => tasks.find(t=>t.id===id)?.position ?? 0;
  const prev = idx > 0 ? pos(cards[idx-1].dataset.id) : null;
  const next = idx < cards.length ? pos(cards[idx].dataset.id) : null;
  const position = prev!==null && next!==null ? (prev+next)/2 : prev!==null ? prev+1 : next!==null ? next-1 : 1;
  const id = dragId; dragId = null;
  const t = tasks.find(x=>x.id===id); Object.assign(t, { status, position }); render(); // sofort anzeigen
  try { await api.update(id, { status, position }); } catch (err) { alert("Verschieben fehlgeschlagen: " + err.message); refresh(); }
});

/* ---------- Name & Team-Code ---------- */
function updateMe(){ $("#meBtn").innerHTML = `Angemeldet als <b>${esc(me)}</b>`; }
function askWho(){
  const needCode = CONFIG.TEAM_CODE && store.get("afiya-code") !== CONFIG.TEAM_CODE;
  $("#codeLabel").hidden = !needCode;
  $("#whoForm").name.value = me;
  $("#whoError").textContent = "";
  $("#whoDlg").showModal();
}
$("#whoDlg").addEventListener("cancel", e => { if (!me) e.preventDefault(); });
$("#whoForm").addEventListener("submit", e => {
  e.preventDefault();
  const f = e.target;
  if (!$("#codeLabel").hidden) {
    if (f.elements.code.value !== CONFIG.TEAM_CODE) { $("#whoError").textContent = "Team-Code ist falsch."; return; }
    store.set("afiya-code", f.elements.code.value);
  }
  me = f.elements.name.value.trim(); store.set("afiya-me", me);
  updateMe(); $("#whoDlg").close(); start();
});
$("#meBtn").addEventListener("click", askWho);

/* ---------- Start ---------- */
let started = false;
function start(){
  if (started) { render(); return; }
  started = true;
  if (!useRemote) { $("#localBanner").hidden = false; setSync("local"); }
  else setSync("wait");
  refresh();
  api.subscribe(() => refresh());
}

fillSelects();
if (!me || (CONFIG.TEAM_CODE && store.get("afiya-code") !== CONFIG.TEAM_CODE)) askWho();
else { updateMe(); start(); }
</script>
</body>
</html>
